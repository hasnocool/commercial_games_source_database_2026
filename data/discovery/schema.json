{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commercial Games Source Database discovery layer",
  "description": "Machine-readable contract for discovery/provenance CSV ledgers.",
  "definitions": {
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "new",
        "needs-verification",
        "accepted-canonical",
        "accepted-canonical-inherited-unreviewed",
        "rejected",
        "duplicate",
        "unauthorized"
      ]
    },
    "source_completeness": {
      "type": "string",
      "enum": [
        "complete-game",
        "game-source",
        "game-source-assets-separate",
        "near-complete",
        "partial-game",
        "engine-only",
        "server-only",
        "sdk-only",
        "source-snapshot",
        "unknown"
      ]
    },
    "authorization_status": {
      "type": "string",
      "enum": [
        "authorized",
        "authorized-restricted-or-unknown",
        "unauthorized-or-unresolved",
        "unknown"
      ]
    },
    "provenance_class": {
      "type": "string",
      "enum": [
        "official-authorized",
        "authorized-source-release",
        "leak",
        "archival-recovery",
        "reverse-engineered",
        "fan-maintained",
        "unknown"
      ]
    },
    "leak_status": {
      "type": "string",
      "enum": [
        "not-leak",
        "reported",
        "suspected",
        "confirmed",
        "historical-confirmed",
        "unknown"
      ]
    },
    "access_status": {
      "type": "string",
      "enum": [
        "public",
        "restricted",
        "removed",
        "private",
        "dead-link",
        "unknown"
      ]
    },
    "redistribution_status": {
      "type": "string",
      "enum": [
        "allowed",
        "restricted",
        "forbidden",
        "unknown"
      ]
    },
    "content_type": {
      "type": "string",
      "description": "Free-form normalized content type such as source-code, binary, assets, full-game, sdk, server, tools, documentation."
    }
  },
  "candidate_required": [
    "candidate_id",
    "candidate_title",
    "linked_game_status",
    "discovery_sources",
    "review_status",
    "provenance_class",
    "leak_status",
    "access_status",
    "redistribution_status",
    "classification_tags"
  ],
  "evidence_required": [
    "evidence_id",
    "candidate_id",
    "evidence_source",
    "evidence_url",
    "evidence_type",
    "provenance_class_claim",
    "leak_status_claim",
    "access_status_claim",
    "redistribution_status_claim",
    "classification_tags"
  ],
  "run_required": [
    "run_id",
    "started_at",
    "discovery_source",
    "query_or_collection",
    "status"
  ]
}
